# Lumio regional V2 + V3 - example names only; no credentials included.
# Copy to .env.local for development. Never commit/share that private file.
# Defaults leave paid AI and regional hosting OFF. Local library works without keys.
LUMIO_PUBLIC_DEMO=false
LUMIO_COMPETITION_PREVIEW=false
LUMIO_AI_ENABLED=false

# Local dev: localhost. The regional production starter requires the exact HTTPS origin.
NEXTAUTH_URL=http://localhost:3000
# Generate at least 32 random characters; never deploy with this empty value.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook is optional; configure approved HTTPS callbacks before public use.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Provider keys are SERVER ONLY. Never use NEXT_PUBLIC_ for any secret.
# Choose models your provider account actually supports; these are project defaults.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional external embeddings: OFF by default; every send also requires UI consent.
LUMIO_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Jobs are only created with explicit consent; worker still checks AI/owner/credits.
# Set true to pause automatic worker kicks during maintenance/local tests.
LUMIO_BACKGROUND_JOBS_DISABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_VOICE=eve

# Optional admin bootstrap: exact verified Google email(s), privately configured.
LUMIO_ADMIN_EMAILS=
# Local dev defaults to .data/lumio.sqlite. The regional starter defaults to
# .data/regional-preview.sqlite and keeps the durable-production override false.
LUMIO_DB_PATH=
LUMIO_ALLOW_LOCAL_DB_PRODUCTION=false
# Regular production requires genuinely persistent storage. The explicitly chosen
# regional mode is an ephemeral competition exception, NOT a PostgreSQL adapter.
# Render Free server accounts/credits/tutor sessions can reset on sleep/restart/deploy.

# Public HTTPS metadata URL, never a credential.
NEXT_PUBLIC_SITE_URL=
LUMIO_PUBLIC_INDEXING=false

# Regional hosting: LUMIO_PUBLIC_DEMO=false, LUMIO_COMPETITION_PREVIEW=true,
# LUMIO_AI_ENABLED=true in hosting Environment, with Google/core AI secrets.
# Use render-regional.yaml and
# node scripts/start-regional.cjs after pnpm build. Do not mix runtime modes.
# V3 guard stores 200 attempts/day UTC and 3 active leases in SQLite.
# Shared across processes only when they use the same database, not separate hosts.
# Counters survive a process restart if the DB survives; free-host DB resets lose them.
